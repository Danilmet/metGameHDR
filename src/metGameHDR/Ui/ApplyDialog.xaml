<Window x:Class="MetGameHDR.Ui.ApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Применить настройки" Width="560" Height="420" MinWidth="420" MinHeight="260"
        Style="{StaticResource {x:Type Window}}" Background="{DynamicResource WindowBackgroundSolid}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PathText" Margin="8,0,8,8" Foreground="{DynamicResource TextSecondary}"
                   TextTrimming="CharacterEllipsis"/>
        <Grid Grid.Row="1" Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" SharedSizeGroup="Key"/>
                <ColumnDefinition Width="*" SharedSizeGroup="Current"/>
                <ColumnDefinition Width="*" SharedSizeGroup="New"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ключ" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Grid.Column="1" Text="Сейчас" Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock Grid.Column="2" Text="Станет" Foreground="{DynamicResource TextSecondary}"/>
        </Grid>
        <ListBox x:Name="ItemsList" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" SharedSizeGroup="Key"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="Current"/>
                            <ColumnDefinition Width="*" SharedSizeGroup="New"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Current, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="{Binding New, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Применить" Style="{StaticResource AccentButton}" IsDefault="True" Click="Apply_Click"/>
            <Button Content="Отмена" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
