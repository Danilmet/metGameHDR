<Window x:Class="MetGameHDR.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="metGameHDR" Height="550" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <TabControl Margin="6">
        <TabItem Header="Игры">
            <DockPanel Margin="6">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="RefreshButton" Content="Обновить" Padding="10,2" Click="Refresh_Click"/>
                    <Button x:Name="AddAppButton" Content="Добавить приложение" Padding="10,2" Margin="6,0,0,0" Click="AddApp_Click"/>
                    <Button x:Name="AddToSteamButton" Content="Добавить выбранное в Steam" Padding="10,2" Margin="6,0,0,0" Click="AddToSteam_Click"/>
                    <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Extended" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="HDR">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding HdrEnabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              Visibility="{Binding HdrApplies, Converter={StaticResource BoolToVisibility}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="В Steam" Binding="{Binding SteamText}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Exe" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding ExeCandidates}" IsEnabled="{Binding CanAddToSteam}"
                                              Text="{Binding MainExe, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Имя для поиска" Binding="{Binding SearchName}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Настройки">
            <StackPanel Margin="6">
                <TextBlock Text="Папки с играми"/>
                <ListBox x:Name="RootsList" Height="120" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="AddRootButton" Content="Добавить" Padding="10,2" Click="AddRoot_Click"/>
                    <Button x:Name="RemoveRootButton" Content="Удалить" Padding="10,2" Margin="6,0,0,0" Click="RemoveRoot_Click"/>
                </StackPanel>
                <TextBlock Text="Ключ SteamGridDB" Margin="0,12,0,0"/>
                <TextBox x:Name="KeyBox" Margin="0,4,0,0"/>
                <TextBlock Text="Аккаунт Steam" Margin="0,12,0,0"/>
                <ComboBox x:Name="SteamUserBox" Width="200" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows" Margin="0,12,0,0" Click="Autostart_Click"/>
                <CheckBox x:Name="TurnOffBox" Content="Выключать HDR при выходе из игры" Margin="0,6,0,0" Click="TurnOff_Click"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
