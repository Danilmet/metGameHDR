<Window x:Class="MetGameHUB.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="metGameHUB" Width="1100" Height="680" MinWidth="820" MinHeight="520"
        Style="{StaticResource {x:Type Window}}" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" UseAeroCaptionButtons="True" CaptionHeight="32" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackgroundSolid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="metGameHUB" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <RadioButton x:Name="GamesTab" Content="Игры" Style="{StaticResource SegmentButton}" IsChecked="True"
                         WindowChrome.IsHitTestVisibleInChrome="True"/>
            <RadioButton x:Name="SettingsTab" Content="Настройки" Style="{StaticResource SegmentButton}" Margin="4,0,0,0"
                         WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="14,8,14,14"
              Visibility="{Binding IsChecked, ElementName=GamesTab, Converter={StaticResource BoolToVisibility}}">
            <Grid x:Name="GamesArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="GamesGrid" SelectionMode="Extended" SelectionChanged="GamesGrid_SelectionChanged"
                         GotMouseCapture="GamesGrid_GotMouseCapture" KeyDown="GamesGrid_KeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Card_PreviewMouseLeftButtonDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Width="150" Height="225" Margin="4" CornerRadius="10"
                                    BorderThickness="2" BorderBrush="Transparent">
                                <Grid>
                                    <!-- Border.CornerRadius does not clip children; the card size is fixed, so a fixed clip works. -->
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,146,221" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <Border x:Name="Placeholder" Background="{DynamicResource Surface}" Visibility="Collapsed">
                                        <Image Source="{Binding Icon}" Width="48" Height="48" Margin="0,0,0,30"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                    <Border VerticalAlignment="Bottom" Background="{DynamicResource Overlay}" Padding="10,28,10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="4,0" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource TextSecondary}" Opacity="0.85">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SteamApplies}" Value="True"/>
                                                                    <Condition Binding="{Binding SteamAdded}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Steam" FontSize="9" FontWeight="Bold" TextDecorations="Strikethrough">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2"
                                            CornerRadius="999" Background="#99000000">
                                        <TextBlock Text="{Binding Source}" Foreground="White" FontSize="10"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,1" CornerRadius="4" Background="#B3000000" IsHitTestVisible="False" BorderThickness="1.5" BorderBrush="#D9FFFFFF" Opacity="0.85">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HdrApplies}" Value="True"/>
                                                            <Condition Binding="{Binding HdrEnabled}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="nonHDR" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="#D9FFFFFF"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hidden}" Value="True">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="RefreshButton" Content="Обновить" Click="Refresh_Click"/>
                    <Button x:Name="AddAppButton" Content="Добавить приложение" Margin="8,0,0,0" Click="AddApp_Click"/>
                    <Button x:Name="AddToSteamButton" Content="Добавить выбранное в Steam" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}" Click="AddToSteam_Click"/>
                    <CheckBox x:Name="ShowHiddenBox" Content="Показать скрытые" Margin="12,0,0,0" VerticalAlignment="Center" Click="ShowHidden_Click"/>
                    <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="GamePage" Visibility="Collapsed"
                  DataContext="{Binding SelectedItem, ElementName=GamesGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Shares GamesGrid's default view, so the hidden-games filter applies here too. -->
                <ListBox x:Name="GameStrip" Margin="0,0,10,0" ItemsSource="{Binding ItemsSource, ElementName=GamesGrid}"
                         SelectionChanged="GameStrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="StripTile_PreviewMouseLeftButtonDown"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Width="60" Height="60" Margin="0,3,6,3" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="Transparent" Background="{DynamicResource Surface}" ToolTip="{Binding Name}">
                                <Grid>
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,56,56" RadiusX="8" RadiusY="8"/>
                                    </Grid.Clip>
                                    <TextBlock x:Name="Letter" Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="CoverCrop" Source="{Binding Cover}" Stretch="UniformToFill" Visibility="Collapsed"/>
                                    <Image Source="{Binding Icon}" Width="44" Height="44"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter TargetName="CoverCrop" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Letter" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Hidden}" Value="True">
                                    <Setter TargetName="Tile" Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Style="{StaticResource CardSurface}">
                    <Grid>
                    <!-- The whole page scrolls, so in a short window the advice table keeps its height instead of collapsing. -->
                    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="← Назад" Height="72" VerticalAlignment="Center" Click="CloseGamePage_Click"/>
                            <Image Grid.Column="1" Source="{Binding Cover}" Height="72" Margin="14,0,0,0" Stretch="Uniform"/>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                <Button Style="{StaticResource LinkButton}" Content="{Binding HltbText, Mode=OneWay}" ToolTip="{Binding HltbTip, Mode=OneWay}"
                                        Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Left" Click="Hltb_Click"
                                        Visibility="{Binding HltbVisible, Converter={StaticResource BoolToVisibility}}"/>
                                <Button x:Name="ParamsToggle" Content="Параметры ▸" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource LinkButton}" Click="ParamsToggle_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <CheckBox Style="{StaticResource HdrToggle}" Content="HDR" VerticalAlignment="Center"
                                          IsChecked="{Binding HdrEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding HdrApplies, Converter={StaticResource BoolToVisibility}}"/>
                                <CheckBox Content="Скрыть" Margin="16,0,12,0" VerticalAlignment="Center" ToolTip="Не показывать в списке и не включать HDR"
                                          IsChecked="{Binding Hidden, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel x:Name="ParamsPanel" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                <TextBlock Text="Exe" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Width="360" IsEditable="True" ItemsSource="{Binding ExeCandidates}" IsEnabled="{Binding CanAddToSteam}"
                                          Text="{Binding MainExe, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Имя для поиска" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox x:Name="SearchNameBox" Width="240" Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" LostFocus="SearchName_LostFocus"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="Качество" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <Slider x:Name="GoalSlider" Width="220" Margin="8,0" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                    TickPlacement="BottomRight" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}" Value="{Binding TargetIndex}"/>
                            <TextBlock Text="Производительность" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <Button Content="Подобрать" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Click="Ask_Click"
                                    IsEnabled="{Binding CanAsk}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3">
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="3" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AskStage, Mode=OneWay}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="Укажите ключ Claude в настройках" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding NoKey, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding AdviceStatus, Mode=OneWay}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdviceStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding TargetText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <Button Content="Сбросить" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                                        Click="ResetTarget_Click" IsEnabled="{Binding IsIdle}"
                                        Visibility="{Binding HasOwnTarget, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <!-- Left-aligned Grid: the * column shrinks to the path's width and trims it only when the links would not fit. -->
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ConfigText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                                           ToolTip="{Binding ConfigText, Mode=OneWay}" ToolTipService.IsEnabled="{Binding HasConfigPath}"/>
                                <Button Grid.Column="1" Content="Найти заново" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                                        Click="Locate_Click" IsEnabled="{Binding CanLocate}"/>
                                <Button Grid.Column="2" Content="Конфиг изменился — Обновить" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                                        Click="RefreshSnapshot_Click" IsEnabled="{Binding IsIdle}"
                                        Visibility="{Binding SnapshotStale, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <TextBlock Text="{Binding ConfigDetail, Mode=OneWay}" MaxWidth="900" HorizontalAlignment="Left" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConfigDetail}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                            <StackPanel Grid.Row="5" Margin="0,14,0,0" MaxWidth="900" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                                <TextBlock Text="{Binding AdviceSummary, Mode=OneWay}" TextWrapping="Wrap"
                                           Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding AdviceHeading, Mode=OneWay}" Margin="0,14,0,6" FontWeight="SemiBold"
                                           Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}"/>
                                <Grid Margin="8,0,8,4" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="Current"/>
                                        <ColumnDefinition Width="Auto" MinWidth="180" SharedSizeGroup="Recommended"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Настройка" Margin="0,0,24,0" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" Text="Сейчас" Margin="0,0,24,0" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Grid.Column="2" Text="Рекомендуется" Margin="0,0,24,0" Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AdviceRows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RowBorder" Padding="8,6" CornerRadius="6" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="Current"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="180" SharedSizeGroup="Recommended"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel MaxWidth="420" Margin="0,0,24,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                            <Border x:Name="ConfigTag" Visibility="Collapsed" Margin="8,0,0,0" Padding="4,0" CornerRadius="4"
                                                                    VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource TextSecondary}">
                                                                <TextBlock Text="конфиг" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Reason, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Current, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="200"
                                                               Margin="0,0,24,0" Foreground="{DynamicResource TextSecondary}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Recommended, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="260"
                                                               Margin="0,0,24,0" FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsConfig}" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                    <Setter TargetName="ConfigTag" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Нажмите «Подобрать», чтобы получить рекомендации" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAdvice}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding AdviceNotes, Mode=OneWay}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AdviceNotes}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding AdviceAt, Mode=OneWay}" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Применить" Style="{StaticResource AccentButton}" Click="Apply_Click" IsEnabled="{Binding CanApplyNow}"/>
                            <Button Content="Отменить" Margin="8,0,0,0" Click="CloseGamePage_Click"/>
                            <Button Content="Вернуть исходный конфиг" Margin="8,0,0,0" Click="Restore_Click" IsEnabled="{Binding IsIdle}"
                                    Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Text="{Binding ApplyStatus, Mode=OneWay}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>

                        <!-- Room under the content so the floating chat bar never covers the last rows. -->
                        <Border Grid.Row="7" Margin="0,14,0,0" Height="{Binding ActualHeight, ElementName=ChatBar}"/>
                    </Grid>
                    </ScrollViewer>

                    <Grid x:Name="ChatBar" VerticalAlignment="Bottom" MaxWidth="760" Margin="16,0"
                          Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}">
                        <!-- The shadow sits on a separate layer: an Effect on the content would blur its text. -->
                        <Border CornerRadius="12" Background="{DynamicResource FloatingSurface}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                        <StackPanel>
                        <StackPanel x:Name="ChatHistory" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Уточнить совет" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="Очистить" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Click="ClearChat_Click" IsEnabled="{Binding IsIdle}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Chat.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <ScrollViewer x:Name="ChatScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Chat}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border MaxWidth="520" Margin="0,0,0,6" Padding="10,6" CornerRadius="8" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mine}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Attachments, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Attachments}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding At, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Спросите, что поменять в совете: текстом, голосом или со скриншотом" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AdviceStatus, Mode=OneWay}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdviceStatus}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                        Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar IsIndeterminate="True" Width="160" Height="3" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AskStage, Mode=OneWay}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="Задайте ключ API в настройках" Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding NoKey, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel IsEnabled="{Binding CanChat}"
                                        Visibility="{Binding HasKey, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl x:Name="ChatChips">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" Padding="8,2,2,2" CornerRadius="6" Background="{DynamicResource Surface}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label, Mode=OneWay}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Refused}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Content="✕" Margin="4,0,0,0" Padding="6,0" Style="{StaticResource LinkButton}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ChatHistoryToggle" Content="💬 ▴" ToolTip="История уточнений" VerticalAlignment="Bottom"
                                            Click="ChatHistoryToggle_Click"/>
                                    <TextBox x:Name="ChatInput" Grid.Column="1" Margin="6,0,0,0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="34"
                                             VerticalScrollBarVisibility="Auto" AllowDrop="True"/>
                                    <Button x:Name="ChatAttach" Grid.Column="2" Content="📎" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="Прикрепить файл"/>
                                    <Button x:Name="ChatMic" Grid.Column="3" Content="🎤" Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="Голосовой ввод (Win+H)"/>
                                    <Button x:Name="ChatSend" Grid.Column="4" Content="Отправить" Margin="6,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource AccentButton}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="ChatBetter" Content="👍 Стало лучше" Margin="0,0,6,0"
                                            Visibility="{Binding WasApplied, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button x:Name="ChatWorse" Content="👎 Стало хуже" Margin="0,0,12,0"
                                            Visibility="{Binding WasApplied, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="Текст и вложения уходят в Anthropic API" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsChecked, ElementName=SettingsTab, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="14,8,14,14" Width="640" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardSurface}">
                    <StackPanel>
                        <TextBlock Text="Папки с играми" FontWeight="SemiBold"/>
                        <ListBox x:Name="RootsList" Height="120" Margin="0,8,0,0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AddRootButton" Content="Добавить" Click="AddRoot_Click"/>
                            <Button x:Name="RemoveRootButton" Content="Удалить" Margin="8,0,0,0" Click="RemoveRoot_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="SteamGridDB" FontWeight="SemiBold"/>
                        <TextBlock Text="Ключ API" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="KeyBox"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Claude" FontWeight="SemiBold"/>
                        <TextBlock Text="Ключ API" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="ClaudeKeyBox"/>
                        <TextBlock Text="Адрес сервера" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="ClaudeUrlBox"/>
                        <TextBlock Text="Пусто — api.anthropic.com; для своего прокси укажи его адрес" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Модель" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="ClaudeModelBox" IsEditable="True" Width="240" HorizontalAlignment="Left">
                            <ComboBoxItem Content="claude-opus-5-5"/>
                            <ComboBoxItem Content="claude-sonnet-5-5"/>
                            <ComboBoxItem Content="claude-haiku-5-5"/>
                            <ComboBoxItem Content="claude-fable-5-1"/>
                        </ComboBox>
                        <TextBlock Text="Пусто — claude-opus-5-5; дешевле — claude-sonnet-5-5" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="По задачам: модель и effort" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Поиск конфига" VerticalAlignment="Center" Margin="0,0,12,4"/>
                            <ComboBox x:Name="LocateModelBox" Grid.Column="1" IsEditable="True" Width="200" Margin="0,0,8,4"/>
                            <ComboBox x:Name="LocateEffortBox" Grid.Column="2" Width="120" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Text="Разбор конфига" VerticalAlignment="Center" Margin="0,0,12,4"/>
                            <ComboBox x:Name="ReadModelBox" Grid.Row="1" Grid.Column="1" IsEditable="True" Width="200" Margin="0,0,8,4"/>
                            <ComboBox x:Name="ReadEffortBox" Grid.Row="1" Grid.Column="2" Width="120" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Text="Подбор настроек" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="AskModelBox" Grid.Row="2" Grid.Column="1" IsEditable="True" Width="200" Margin="0,0,8,0"/>
                            <ComboBox x:Name="AskEffortBox" Grid.Row="2" Grid.Column="2" Width="120"/>
                        </Grid>
                        <TextBlock Text="Пусто — общая модель; effort по умолчанию: поиск и подбор medium, разбор low" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Цель по умолчанию" Margin="0,12,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Качество" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                            <Slider x:Name="DefaultTargetSlider" Width="220" Margin="8,0" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                    TickPlacement="BottomRight" VerticalAlignment="Center"/>
                            <TextBlock Text="Производительность" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <TextBlock x:Name="DefaultTargetText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Steam" FontWeight="SemiBold"/>
                        <TextBlock Text="Аккаунт" Margin="0,8,0,4" Foreground="{DynamicResource TextSecondary}"/>
                        <ComboBox x:Name="SteamUserBox" Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardSurface}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Поведение" FontWeight="SemiBold"/>
                        <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows" Margin="0,10,0,0" Click="Autostart_Click"/>
                        <CheckBox x:Name="TurnOffBox" Content="Выключать HDR при выходе из игры" Margin="0,8,0,0" Click="TurnOff_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="VersionText" VerticalAlignment="Center"/>
                            <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" Margin="10,0,0,0" Click="CheckUpdates_Click"/>
                            <TextBlock x:Name="CheckUpdatesText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel x:Name="UpdatePanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="UpdateText" VerticalAlignment="Center"/>
                            <Button x:Name="UpdateButton" Content="Обновить" Margin="10,0,0,0" Click="Update_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
