<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#CC000000" />
    <SolidColorBrush x:Key="WindowBackgroundSolid" Color="#000000" />
    <SolidColorBrush x:Key="Surface" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Hdr" Color="#30D158" />
    <LinearGradientBrush x:Key="Overlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#E6000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
